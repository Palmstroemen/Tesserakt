# Vorlage: als server/.env speichern und ausfuellen (.env ist in .gitignore)

# Testbetrieb ueber Tailscale Funnel (ohne Caddy und Domain): die naechste Zeile einkommentieren
# COMPOSE_FILE=docker-compose.funnel.yml

# Adresse des Backends, wie sie in die App gebaut wird (VITE_API_BASE=https://<DOMAIN>)
DOMAIN=api.tesserakt.example
# Fuer Let's Encrypt (Hinweise zu ablaufenden Zertifikaten)
ACME_EMAIL=

# Sicherung (sicherung.sh): Ziel fuer rsync ueber SSH, z. B. die Synology ueber Tailscale
SICHERUNG_ZIEL=benutzer@synology:/volume1/sicherung/tesserakt
# Wie viele taegliche Sicherungen am Server bleiben
SICHERUNG_TAGE=14
