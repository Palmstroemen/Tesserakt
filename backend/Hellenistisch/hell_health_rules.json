    "_intro": "Körper und Konstitution nach Sonnenzeichen. Ptolemy Tetrabiblos III.12; Valens.",
    "widder": { "text_de": "Kopf, Gehirn, Gesicht. Kräftige Konstitution; Anfälligkeit für Kopfschmerzen, Fieber, Verletzungen.", "dimensionen_vektor": { "gesundheit": 0.65, "veraenderung": 0.55 }, "quelle": "Tetrabiblos III.12" },
    "stier": { "text_de": "Hals, Nacken, Kehle. Solide Konstitution; Neigung zu Halsleiden, Trägheit.", "dimensionen_vektor": { "gesundheit": 0.55, "veraenderung": 0.35 }, "quelle": "Tetrabiblos III.12" },
    "zwillinge": { "text_de": "Schultern, Arme, Lungen, Nerven. Beweglich, nervöse Konstitution.", "dimensionen_vektor": { "gesundheit": 0.5, "veraenderung": 0.7, "kreativitaet": 0.55 }, "quelle": "Tetrabiblos III.12" },
    "krebs": { "text_de": "Brust, Magen, Verdauung. Emotionen beeinflussen Gesundheit stark.", "dimensionen_vektor": { "gesundheit": 0.5, "liebe": 0.5, "veraenderung": 0.5 }, "quelle": "Tetrabiblos III.12" },
    "loewe": { "text_de": "Herz, Rücken, Oberkörper. Starke Vitalität; Überanstrengung meiden.", "dimensionen_vektor": { "gesundheit": 0.75, "beruf": 0.5, "veraenderung": 0.45 }, "quelle": "Tetrabiblos III.12" },
    "jungfrau": { "text_de": "Darm, Verdauung, Nerven. Empfindliche Konstitution; Hygiene wichtig.", "dimensionen_vektor": { "gesundheit": 0.5, "veraenderung": 0.4 }, "quelle": "Tetrabiblos III.12" },
    "waage": { "text_de": "Nieren, Lenden, Haut. Ausgewogene Konstitution; Harmonie fördert Gesundheit.", "dimensionen_vektor": { "gesundheit": 0.6, "liebe": 0.55, "soziales": 0.5 }, "quelle": "Tetrabiblos III.12" },
    "skorpion": { "text_de": "Geschlechtsorgane, Ausscheidung. Intensive Konstitution; Regeneration wichtig.", "dimensionen_vektor": { "gesundheit": 0.45, "veraenderung": 0.7, "spiritualitaet": 0.5 }, "quelle": "Tetrabiblos III.12" },
    "schuetze": { "text_de": "Hüften, Oberschenkel, Leber. Aktive Konstitution; Maßhalten bei Genuss.", "dimensionen_vektor": { "gesundheit": 0.6, "veraenderung": 0.6, "spiritualitaet": 0.5 }, "quelle": "Tetrabiblos III.12" },
    "steinbock": { "text_de": "Knie, Knochen, Gelenke, Haut. Kühle Konstitution; chronische Leiden möglich.", "dimensionen_vektor": { "gesundheit": 0.4, "veraenderung": 0.3, "beruf": 0.5 }, "quelle": "Tetrabiblos III.12" },
    "wassermann": { "text_de": "Unterschenkel, Kreislauf, Nerven. Ungewöhnliche Konstitution; Ruhephasen.", "dimensionen_vektor": { "gesundheit": 0.5, "veraenderung": 0.65, "kreativitaet": 0.5 }, "quelle": "Tetrabiblos III.12" },
    "fische": { "text_de": "Füße, Lymphe, Psyche. Empfindsame Konstitution; Grenzen setzen.", "dimensionen_vektor": { "gesundheit": 0.45, "spiritualitaet": 0.65, "kreativitaet": 0.55 }, "quelle": "Tetrabiblos III.12" }
  },
