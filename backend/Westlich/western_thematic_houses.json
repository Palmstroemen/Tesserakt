  "planeten_im_7_haus": {
    "sonne": {
      "text_de": "Ehe mit einer bedeutenden, edlen oder gut gestellten Person. Öffentliche Verbindung. Partner bringt gesellschaftliches Ansehen. Mögliche Dominanz des Partners. Ehe trägt zur eigenen Karriere bei.",
      "vektor": {
        "liebe": 0.75,
        "soziales": 0.75,
        "finanzen": 0.5,
        "beruf": 0.5
      },
      "quelle": "Sepharial S.75, Raphael S.110"
    },
    "mond": {
      "text_de": "Partner wandelbar, volksnahe, gutmütig. Frühe oder mehrfache Ehe möglich. Emotionale Verbindung zentral. Starke Bindung an Mutterfiguren des Partners. Häufige Ortswechsel durch Ehe.",
      "vektor": {
        "liebe": 0.75,
        "veraenderung": 0.75,
        "soziales": 0.5,
        "finanzen": 0.5
      },
      "quelle": "Sepharial S.75, Raphael S.110"
    },
    "merkur": {
      "text_de": "Intellektuell verbundener Partner. Kommunikation in der Ehe zentral. Partner oft jünger, vielseitig, geistig rege. Geistige Kompatibilität wichtiger als Sinnlichkeit.",
      "vektor": {
        "liebe": 0.5,
        "soziales": 0.75,
        "kreativitaet": 0.75,
        "veraenderung": 0.5
      },
      "quelle": "Sepharial S.75, Raphael S.110"
    },
    "venus": {
      "text_de": "Günstigste Ehestellung. Schöner, liebenswürdiger, angenehmer Partner. Harmonische, glückliche Ehe. Liebe bleibt lebendig. Frieden und gegenseitige Zuneigung dauerhaft.",
      "vektor": {
        "liebe": 1.0,
        "soziales": 0.75,
        "finanzen": 0.5,
        "kreativitaet": 0.75
      },
      "quelle": "Sepharial S.75, Raphael S.110"
    },
    "mars": {
      "text_de": "Leidenschaftliche, aber konfliktreiche Ehe. Partner energisch, herrschsüchtig oder impulsiv. Streit, Trennung, Scheidung oder Verwitwung möglich. Bei guten Aspekten: starke körperliche Anziehung.",
      "vektor": {
        "liebe": 0.25,
        "veraenderung": 0.75,
        "soziales": 0.25,
        "gesundheit": 0.25
      },
      "quelle": "Sepharial S.75, Raphael S.110"
    },
    "jupiter": {
      "text_de": "Glückliche, wohlhabende Ehe. Partner großzügig, wohlgestellt, angesehen. Finanzielle Verbesserung durch Ehe. Rechtlich gesicherte Verbindung. Eheliche Treue und Beständigkeit.",
      "vektor": {
        "liebe": 1.0,
        "finanzen": 0.75,
        "soziales": 0.75,
        "spiritualitaet": 0.5
      },
      "quelle": "Sepharial S.75, Raphael S.111"
    },
    "saturn": {
      "text_de": "Späte, ernste oder erschwerliche Ehe. Partner älter, nüchtern oder kontrollierend. Eheliche Pflicht steht über Romantik. Mögliche Einschränkungen oder Verwitwung. Treue und Dauerhaftigkeit.",
      "vektor": {
        "liebe": 0.25,
        "soziales": 0.25,
        "finanzen": 0.25,
        "veraenderung": 0.25
      },
      "quelle": "Sepharial S.75, Raphael S.111"
    },
    "uranus": {
      "text_de": "Ungewöhnliche, plötzliche oder unkonventionelle Verbindung. Freie Ehe, offene Beziehung oder mehrfache Eheschlüsse. Partner exzentrisch oder originell. Scheidung oder Trennung wahrscheinlicher.",
      "vektor": {
        "liebe": 0.5,
        "veraenderung": 1.0,
        "kreativitaet": 0.75,
        "soziales": 0.25
      },
      "quelle": "Sepharial S.76, DeVore"
    },
    "neptun": {
      "text_de": "Romantisch-idealistische, oft enttäuschende Ehe. Partner rätselhaft, unzuverlässig oder täuschend. Geheime Verbindungen möglich. Spirituelle oder künstlerische Verbundenheit. Täuschungsgefahr.",
      "vektor": {
        "liebe": 0.5,
        "spiritualitaet": 0.75,
        "kreativitaet": 0.75,
        "soziales": 0.25
      },
      "quelle": "Sepharial S.76, DeVore"
    },
    "pluto": {
      "text_de": "Transformative, tiefgreifende Ehe die das Leben grundlegend verändert. Obsessive Anziehung möglich. Machtkämpfe in der Partnerschaft. Ehe endet selten ohne tiefe Veränderung beider.",
      "vektor": {
        "liebe": 0.5,
        "veraenderung": 1.0,
        "spiritualitaet": 0.75,
        "soziales": 0.25
      },
      "quelle": "DeVore Encyclopedia"
    }
  },
  "planeten_im_8_haus": {
    "sonne": {
      "text_de": "Erbschaften von Vater oder bedeutenden Männern. Partnervermögen günstig. Interesse an Tod und Nachlassangelegenheiten. Spätlebens-Wohlstand durch Partnermittel.",
      "vektor": {
        "finanzen": 0.75,
        "veraenderung": 0.75,
        "spiritualitaet": 0.5,
        "liebe": 0.5
      },
      "quelle": "Sepharial S.67, Raphael S.100"
    },
    "mond": {
      "text_de": "Wechselhafte Erbschaftsaussichten. Mitgift oder Erbe von Mutter oder weiblichen Verwandten. Finanziell von Partnern oder Familie abhängig.",
      "vektor": {
        "finanzen": 0.5,
        "veraenderung": 0.5,
        "soziales": 0.5,
        "liebe": 0.5
      },
      "quelle": "Raphael S.100"
    },
    "merkur": {
      "text_de": "Einnahmen durch Verwaltung fremden Vermögens, Testamentsvollstreckung, geistige Eigentumsrechte. Mehrere kleine Erbschaften möglich.",
      "vektor": {
        "finanzen": 0.5,
        "beruf": 0.75,
        "veraenderung": 0.5,
        "kreativitaet": 0.5
      },
      "quelle": "Sepharial S.67"
    },
    "venus": {
      "text_de": "Günstige Erbschaften, besonders von Frauen. Partnervermögen bringt Wohlstand. Schenkungen durch Freunde. Erbe durch Kunst oder Kultur.",
      "vektor": {
        "finanzen": 0.75,
        "liebe": 0.75,
        "soziales": 0.5,
        "veraenderung": 0.5
      },
      "quelle": "Raphael S.100"
    },
    "mars": {
      "text_de": "Verluste durch Erbstreitigkeiten oder impulsive Handlungen. Einnahmen durch Unternehmen mit Risiko. Partnervermögen gefährdet. Testamentskonflikte möglich.",
      "vektor": {
        "finanzen": 0.25,
        "veraenderung": 0.75,
        "soziales": 0.25,
        "liebe": 0.25
      },
      "quelle": "Sepharial S.67, Raphael S.100"
    },
    "jupiter": {
      "text_de": "Beste Erbschaftsstellung. Großes Erbe, reicher Partner, Nachlassverwaltung. Gemeinsame Unternehmungen bringen Reichtum. Finanziell günstigste 8.-Haus-Stellung.",
      "vektor": {
        "finanzen": 1.0,
        "veraenderung": 0.5,
        "soziales": 0.75,
        "liebe": 0.75
      },
      "quelle": "Sepharial S.67, Raphael S.100"
    },
    "saturn": {
      "text_de": "Eingeschränkte Erbschaften, Verzögerungen. Verlust durch Partnervermögen oder Schulden möglich. Langsam akkumuliertes Fremdeinkommen. Geduld notwendig.",
      "vektor": {
        "finanzen": 0.25,
        "veraenderung": 0.5,
        "soziales": 0.25,
        "liebe": 0.25
      },
      "quelle": "Raphael S.100"
    },
    "uranus": {
      "text_de": "Plötzliche Erbschaften oder unerwartete Verluste. Ungewöhnliche Quellen für Fremdeinkommen. Versicherungsauszahlungen, technische Lizenzgebühren.",
      "vektor": {
        "finanzen": 0.5,
        "veraenderung": 1.0,
        "kreativitaet": 0.5,
        "spiritualitaet": 0.5
      },
      "quelle": "Sepharial S.67"
    },
    "neptun": {
      "text_de": "Unklare Erbschaftssituation, Betrug oder Verwirrung bei Testamenten möglich. Erbschaft durch spirituelle oder künstlerische Tätigkeiten des Erblassers.",
      "vektor": {
        "finanzen": 0.25,
        "veraenderung": 0.5,
        "spiritualitaet": 0.75,
        "kreativitaet": 0.5
      },
      "quelle": "Sepharial S.67"
    },
    "pluto": {
      "text_de": "Radikale finanzielle Transformation durch Erbe oder Partnervermögen. Alles-oder-Nichts-Situation. Macht und Kontrolle über fremde Ressourcen.",
      "vektor": {
        "finanzen": 0.5,
        "veraenderung": 1.0,
        "spiritualitaet": 0.75,
        "soziales": 0.25
      },
      "quelle": "DeVore Encyclopedia"
    }
  },
  "planeten_im_10_haus": {
    "sonne": {
      "text_de": "Höchste Berufsstellung. Ruhm, Ehren, öffentliche Anerkennung sehr wahrscheinlich. Führungspositionen, Herrschaft, Regierungsamt. Starker Antrieb für weltliche Größe. Günstigste Sonnenstellung für Karriere.",
      "vektor": {
        "beruf": 1.0,
        "soziales": 1.0,
        "finanzen": 0.75,
        "liebe": 0.25
      },
      "quelle": "Sepharial S.70, Raphael S.103"
    },
    "mond": {
      "text_de": "Wechselhafte öffentliche Stellung. Erfolg durch Volksnähe, öffentliche Dienstleistungen, Handel oder weibliche Gunst. Stimmungsabhängige Karriere. Popularität möglich.",
      "vektor": {
        "beruf": 0.5,
        "soziales": 0.75,
        "veraenderung": 0.75,
        "finanzen": 0.5
      },
      "quelle": "Sepharial S.70, Raphael S.103"
    },
    "merkur": {
      "text_de": "Intellektuell geprägter Beruf. Erfolg in Schriftstellerei, Wissenschaft, Lehre, Recht, Journalismus, Handel. Vielseitiger Karriereweg. Geistesgaben anerkannt.",
      "vektor": {
        "beruf": 0.75,
        "kreativitaet": 1.0,
        "soziales": 0.5,
        "finanzen": 0.5
      },
      "quelle": "Sepharial S.70, Raphael S.103"
    },
    "venus": {
      "text_de": "Karriere in Kunst, Musik, Mode, Unterhaltung oder gesellschaftlichen Berufen. Beliebtheit und Charme fördern Aufstieg. Frauen oder Schönheit spielen Rolle im Berufsleben.",
      "vektor": {
        "beruf": 0.75,
        "kreativitaet": 1.0,
        "soziales": 0.75,
        "liebe": 0.5
      },
      "quelle": "Sepharial S.70, Raphael S.103"
    },
    "mars": {
      "text_de": "Karriere durch Tatkraft, Energie und Durchsetzungswillen. Militär, Chirurgie, Technik, Sport, Industrie. Hohe Ambitionen, aber auch Konflikte in Karriere möglich.",
      "vektor": {
        "beruf": 0.75,
        "finanzen": 0.5,
        "soziales": 0.25,
        "veraenderung": 0.75
      },
      "quelle": "Sepharial S.70, Raphael S.104"
    },
    "jupiter": {
      "text_de": "Günstigste Berufsstellung nach Sonne. Hohe gesellschaftliche Stellung. Juristische, kirchliche, akademische, finanzielle oder diplomatische Berufe. Ehrungen und Auszeichnungen wahrscheinlich.",
      "vektor": {
        "beruf": 1.0,
        "soziales": 1.0,
        "finanzen": 0.75,
        "spiritualitaet": 0.75
      },
      "quelle": "Sepharial S.70, Raphael S.104"
    },
    "saturn": {
      "text_de": "Langsamer aber beständiger Aufstieg durch Disziplin und Ausdauer. Berufe in Landwirtschaft, Bergbau, Verwaltung, Architektur. Späte Anerkennung. Gefahr des gesellschaftlichen Sturzes.",
      "vektor": {
        "beruf": 0.5,
        "soziales": 0.25,
        "finanzen": 0.5,
        "veraenderung": 0.25
      },
      "quelle": "Sepharial S.70, Raphael S.104"
    },
    "uranus": {
      "text_de": "Ungewöhnlicher, origineller Berufsweg. Plötzliche Auf- und Abstiege. Technik, Elektrizität, Erfindung, Reform, Astrologie. Berühmt für Originalität oder Exzentrizität.",
      "vektor": {
        "beruf": 0.5,
        "kreativitaet": 1.0,
        "soziales": 0.5,
        "veraenderung": 1.0
      },
      "quelle": "Sepharial S.70"
    },
    "neptun": {
      "text_de": "Berufe in Kunst, Medizin, Seefahrt, Spiritualität, Film, Chemie, Täuschung. Unklare oder geheimnisvolle Karriere. Ruf kann leiden. Mystische oder künstlerische Berühmtheit möglich.",
      "vektor": {
        "beruf": 0.5,
        "kreativitaet": 1.0,
        "spiritualitaet": 1.0,
        "soziales": 0.25
      },
      "quelle": "Sepharial S.71"
    },
    "pluto": {
      "text_de": "Transformative Karriere mit intensivem Macht- und Kontrollthema. Berufe in Krisenmanagement, Psychologie, geheimen Behörden, Unternehmenstransformation. Weltverändernder Einfluss möglich.",
      "vektor": {
        "beruf": 0.75,
        "veraenderung": 1.0,
        "spiritualitaet": 0.75,
        "soziales": 0.5
      },
      "quelle": "DeVore Encyclopedia"
    }
  },
  "planeten_im_11_haus": {
    "sonne": {
      "text_de": "Gewinne durch mächtige Freunde und Gönner. Beruflicher Lohn überdurchschnittlich. Ziele und Hoffnungen werden durch Einfluss anderer erfüllt.",
      "vektor": {
        "finanzen": 0.75,
        "soziales": 1.0,
        "beruf": 0.75,
        "liebe": 0.5
      },
      "quelle": "Sepharial S.68"
    },
    "mond": {
      "text_de": "Schwankender Gewinn aus dem Beruf. Frauen spielen Rolle bei sozialen Verbindungen. Günstige gesellschaftliche Kontakte, aber wechselhaft.",
      "vektor": {
        "finanzen": 0.5,
        "soziales": 0.75,
        "veraenderung": 0.5,
        "liebe": 0.5
      },
      "quelle": "Raphael S.101"
    },
    "merkur": {
      "text_de": "Intelligente, vielseitige Freunde fördern Einnahmen. Gewinne durch geistige Arbeit, Schreiben, Medien. Netzwerke bringen materielle Vorteile.",
      "vektor": {
        "finanzen": 0.5,
        "soziales": 0.75,
        "kreativitaet": 0.75,
        "beruf": 0.5
      },
      "quelle": "Sepharial S.68"
    },
    "venus": {
      "text_de": "Freundschaften mit einflussreichen, angenehmen Personen. Gewinne durch Kunst, Unterhaltung, soziale Verbindungen. Finanzielle Gunstbezeugungen von Freunden.",
      "vektor": {
        "finanzen": 0.75,
        "soziales": 1.0,
        "liebe": 0.75,
        "kreativitaet": 0.75
      },
      "quelle": "Sepharial S.68, Raphael S.101"
    },
    "mars": {
      "text_de": "Energische Freunde, aber Streitigkeiten möglich. Gewinne durch Energie und Durchsetzungsvermögen. Vorsicht vor unzuverlässigen Verbündeten.",
      "vektor": {
        "finanzen": 0.5,
        "soziales": 0.25,
        "beruf": 0.5,
        "veraenderung": 0.5
      },
      "quelle": "Raphael S.101"
    },
    "jupiter": {
      "text_de": "Beste 11.-Haus-Position. Wohlhabende, einflussreiche Freunde. Hohe Gewinne aus dem Beruf. Hoffnungen und Wünsche erfüllen sich leicht. Philanthropische Verbindungen.",
      "vektor": {
        "finanzen": 1.0,
        "soziales": 1.0,
        "beruf": 1.0,
        "spiritualitaet": 0.5
      },
      "quelle": "Sepharial S.68, Raphael S.101"
    },
    "saturn": {
      "text_de": "Wenige, aber treue ältere Freunde. Gewinne langsam und durch Mühe. Ziele erfordern Geduld. Freunde können zu Lasten werden.",
      "vektor": {
        "finanzen": 0.25,
        "soziales": 0.25,
        "beruf": 0.5,
        "veraenderung": 0.25
      },
      "quelle": "Raphael S.101"
    },
    "uranus": {
      "text_de": "Exzentrische oder einzigartige Freunde. Unerwartete finanzielle Gewinne. Unkonventionelle Einkommensquellen durch originelle Netzwerke.",
      "vektor": {
        "finanzen": 0.5,
        "soziales": 0.5,
        "kreativitaet": 0.75,
        "veraenderung": 0.75
      },
      "quelle": "Sepharial S.68"
    },
    "neptun": {
      "text_de": "Idealistisch geprägte Freundschaften. Täuschungsgefahr durch falsche Freunde. Gewinne durch spirituelle oder künstlerische Gemeinschaften.",
      "vektor": {
        "finanzen": 0.25,
        "soziales": 0.5,
        "spiritualitaet": 0.75,
        "kreativitaet": 0.75
      },
      "quelle": "Sepharial S.68"
    },
    "pluto": {
      "text_de": "Mächtige, transformative Verbündete. Gewinne durch kollektive Macht oder Masseneinfluss. Freundschaften verändern das Leben tiefgreifend.",
      "vektor": {
        "finanzen": 0.5,
        "soziales": 0.5,
        "veraenderung": 1.0,
        "beruf": 0.5
      },
      "quelle": "DeVore Encyclopedia"
    }
  },
