{
  "planeten_im_2_haus": {
    "sonne": {
      "text_de": "Finanzen durch eigene Initiative und Willenskraft. Einnahmen durch Positionen in Behörden, Adel oder öffentlichem Dienst. Freigebig, aber Stolz auf Besitz. Ererbtes Vermögen möglich.",
      "vektor": {
        "finanzen": 0.75,
        "beruf": 0.75,
        "soziales": 0.5,
        "liebe": 0.25
      },
      "quelle": "Sepharial S.65, Raphael S.98"
    },
    "mond": {
      "text_de": "Schwankende Finanzen, abhängig von Mondphasen und Stimmungen. Einnahmen durch Handel, Lebensmittel, öffentliche Güter, Frauen oder Reisen. Volksnahe Geschäfte günstig.",
      "vektor": {
        "finanzen": 0.5,
        "beruf": 0.5,
        "veraenderung": 0.75,
        "soziales": 0.5
      },
      "quelle": "Sepharial S.65, Raphael S.98"
    },
    "merkur": {
      "text_de": "Einnahmen durch Intellekt, Schreiben, Handel, Kommunikation, Reisen oder Lehrtätigkeit. Finanziell clever, aber unbeständig. Mehrere Einkommensquellen möglich.",
      "vektor": {
        "finanzen": 0.5,
        "beruf": 0.75,
        "kreativitaet": 0.75,
        "soziales": 0.5
      },
      "quelle": "Sepharial S.65"
    },
    "venus": {
      "text_de": "Günstig für Finanzen, besonders durch Kunst, Mode, Schmuck, Luxusgüter oder weibliche Verbindungen. Geldglück durch soziale Kontakte. Leichte Gefahr der Verschwendung.",
      "vektor": {
        "finanzen": 0.75,
        "kreativitaet": 0.75,
        "soziales": 0.75,
        "liebe": 0.5
      },
      "quelle": "Sepharial S.65, Raphael S.98"
    },
    "mars": {
      "text_de": "Energie und Ehrgeiz bringen Einnahmen, aber Impulsivität gefährdet Kapital. Einnahmen durch körperliche Arbeit, Militär, Chirurgie oder Industrie. Verluste durch Unvorsichtigkeit.",
      "vektor": {
        "finanzen": 0.25,
        "beruf": 0.5,
        "veraenderung": 0.75,
        "gesundheit": 0.25
      },
      "quelle": "Sepharial S.65, Raphael S.99"
    },
    "jupiter": {
      "text_de": "Stärkste Finanzposition. Wohlstand durch rechtliche Berufe, Kirche, Bildung, Finanzwesen oder Import/Export. Erbschaften, Lotteriegewinne, großzügige Gönner möglich. Selten in Armut.",
      "vektor": {
        "finanzen": 1.0,
        "beruf": 1.0,
        "soziales": 0.75,
        "spiritualitaet": 0.5
      },
      "quelle": "Sepharial S.65, Raphael S.99"
    },
    "saturn": {
      "text_de": "Langsamer, mühsamer Vermögensaufbau. Einnahmen durch Landwirtschaft, Bergbau, Immobilien, ältere Personen. Sparsamkeit erzwungen. Mittlerer Wohlstand durch harte Arbeit möglich.",
      "vektor": {
        "finanzen": 0.5,
        "beruf": 0.5,
        "veraenderung": 0.25,
        "soziales": 0.25
      },
      "quelle": "Sepharial S.66, Raphael S.99"
    },
    "uranus": {
      "text_de": "Finanzielle Überraschungen – plötzliche Gewinne und Verluste. Einnahmen durch Technik, Elektrizität, Erfindungen oder spekulative Unternehmungen. Instabiles Vermögen, oft ungewöhnliche Quellen.",
      "vektor": {
        "finanzen": 0.5,
        "beruf": 0.5,
        "veraenderung": 1.0,
        "kreativitaet": 0.75
      },
      "quelle": "Sepharial S.66"
    },
    "neptun": {
      "text_de": "Unklare Finanzlage, Betrugsrisiko. Einnahmen möglicherweise durch Schifffahrt, Öl, Pharmazie, Kunst oder spirituelle Tätigkeiten. Vorsicht bei Spekulationen und Geschäftspartnern.",
      "vektor": {
        "finanzen": 0.25,
        "beruf": 0.25,
        "spiritualitaet": 0.75,
        "kreativitaet": 0.75
      },
      "quelle": "Sepharial S.66"
    },
    "pluto": {
      "text_de": "Transformatives Finanzleben – tiefer Verlust und Wiederaufstieg möglich. Einnahmen durch Machtpositionen, Unternehmensrestrukturierung, Erbschaften oder verborgene Ressourcen.",
      "vektor": {
        "finanzen": 0.5,
        "beruf": 0.5,
        "veraenderung": 1.0,
        "spiritualitaet": 0.5
      },
      "quelle": "DeVore Encyclopedia"
    }
