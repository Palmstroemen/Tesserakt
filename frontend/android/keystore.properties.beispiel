# Vorlage: als keystore.properties (gleicher Ordner) speichern und ausfuellen. keystore.properties ist in
# .gitignore. Den Keystore selbst ausserhalb des Repos ablegen und an einem zweiten Ort sichern: ohne ihn kann
# man keine Updates mehr hochladen (Google kann den Upload-Schluessel zuruecksetzen, das dauert aber Tage).
storeFile=/home/oliver/Schluessel/tesserakt-upload.jks
storePassword=
keyAlias=tesserakt
keyPassword=
